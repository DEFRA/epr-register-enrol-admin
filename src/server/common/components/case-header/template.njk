{# Ported from management-fe (origin/main 0bd3b85), src/server/common/components/case-header/template.njk. A copy: there is no shared package to import it from. #}
{# Admin UI changes:                                                   #}
{#  - the reference line shows "Missing from work item" or "None" when #}
{#    there is no application reference (buildCaseHeader), where        #}
{#    management-fe shows the work item ID it falls back to;            #}
{#  - the title is an h3, as the header sits under the page's           #}
{#    "Regulator view" h2, where management-fe's is the page's h1;      #}
{#  - the back link and reference are a plain list, not a second        #}
{#    "Breadcrumb" nav (the page has its own breadcrumbs), and the      #}
{#    reference is not marked as the current page.                      #}
{# ------------------------------------------------------------------ #}
{# Case header (RA-295 AC01).                                          #}
{#                                                                     #}
{# Full-bleed, light-green panel that sits directly beneath the service #}
{# navigation on every individual work item page. Carries the back link #}
{# to the Applications list, the accreditation reference, the           #}
{# organisation name + ID and a meta grid of bold labels stacked above  #}
{# their values (material, status, assigned to, due date, registration #}
{# number, and (RA-493) payment date and payment amount).               #}
{#                                                                     #}
{# RA-739. A case type can supply a `caption` (shown above the title)  #}
{# and its own `title`, which replaces the organisation name and ID.   #}
{#                                                                     #}
{# All values arrive pre-formatted from `buildCaseHeader()`; this       #}
{# template does no data access and no formatting, so it stays safe to  #}
{# reuse from any controller. GDS/Nunjucks auto-escaping applies to     #}
{# every interpolation — nothing is emitted as raw HTML (AC05 keeps the #}
{# whole thing JavaScript-free).                                        #}
{# ------------------------------------------------------------------ #}
{% from "govuk/components/tag/macro.njk" import govukTag %}
<div class="app-case-header" data-testid="case-header">
  <div class="govuk-width-container">
    <div class="app-case-header__breadcrumbs">
      <ol class="app-case-header__breadcrumbs-list">
        <li class="app-case-header__breadcrumbs-item">
          <a class="govuk-link app-case-header__back-link"
             href="{{ params.backHref }}"
             data-testid="case-header-applications-link">{{ params.backText }}</a>
        </li>
        <li class="app-case-header__breadcrumbs-item"
            data-testid="case-header-accreditation-ref">
          {%- if params.applicationRef -%}
            {{ params.applicationRef }}
          {%- elif params.applicationRefMissing -%}
            <strong class="app-missing">Missing from work item</strong>
          {%- else -%}
            None
          {%- endif -%}
        </li>
      </ol>
    </div>

    {% if params.caption %}
      <span class="govuk-caption-l app-case-header__caption"
            data-testid="case-header-caption">{{ params.caption }}</span>
    {% endif %}
    <h3 class="govuk-heading-l app-case-header__title">
      {%- if params.title -%}
        <span data-testid="case-header-title">{{ params.title }}</span>
      {%- else -%}
        <span data-testid="case-header-org-name">{{ params.organisationName }}</span>{% if params.organisationId %} <span class="app-case-header__org-id">(<span data-testid="case-header-org-id">{{ params.organisationId }}</span>)</span>{% endif %}
      {%- endif -%}
    </h3>

    <dl class="app-case-header__meta" data-testid="case-header-meta">
      {% for entry in params.meta %}
        <div class="app-case-header__meta-item">
          <dt class="app-case-header__meta-label">{{ entry.label }}:</dt>
          <dd class="app-case-header__meta-value"
              data-testid="case-header-{{ entry.key }}">
            {%- if entry.tagClass -%}
              {{ govukTag({ text: entry.value, classes: entry.tagClass, attributes: { "data-testid": "work-item-state-tag" } }) }}
            {%- else -%}
              {{ entry.value }}
            {%- endif -%}
          </dd>
        </div>
      {% endfor %}
    </dl>
  </div>
</div>
