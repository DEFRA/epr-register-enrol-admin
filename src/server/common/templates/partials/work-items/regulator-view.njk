{# ------------------------------------------------------------------ #}
{# Regulator view (RA-752 AC09): management-fe's work item page,       #}
{# read-only. Ported from management-fe origin/main b0b9694:           #}
{#  - banners: src/server/routes/work-items/detail.njk (withdrawn      #}
{#    notice, notification failed) and                                 #}
{#    src/server/routes/standard-lifecycle/detail.njk (pending contact) #}
{#  - Application summary: detail.njk `applicationSummary` block and   #}
{#    src/server/routes/re-accreditation/detail-v1.njk                 #}
{#    `summaryListBefore` (issued accreditation)                       #}
{#  - add-ORS Application summary:                                   #}
{#    src/server/routes/add-overseas-site/detail-v1.njk               #}
{#  - Application history: src/server/routes/work-items/audit-log.njk  #}
{#  - Additional information:                                          #}
{#    src/server/routes/work-items/additional-information.njk          #}
{# Left out, as each changes the work item: the actions and assignment #}
{# panel, flash and success banners, and the "Back to work item" links #}
{# (the tabs are on this page).                                        #}
{# ------------------------------------------------------------------ #}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% from "govuk/components/notification-banner/macro.njk" import govukNotificationBanner %}
{% from "govuk/components/panel/macro.njk" import govukPanel %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/tag/macro.njk" import govukTag %}
{% from "govuk/components/warning-text/macro.njk" import govukWarningText %}
{% from "case-header/macro.njk" import appCaseHeader %}
{% from "case-tabs/macro.njk" import appCaseTabs %}
{% from "partials/work-items/summary-macros.njk" import documentItem, newPrefix, overseasSiteList, businessPlanPair, siteDetails %}

<h2 class="govuk-heading-m">Regulator view</h2>
<p class="govuk-body">The work item as a caseworker sees it in Case management. Nothing here can be changed. People’s names and email addresses are masked.</p>

<div class="app-regulator-view" data-testid="regulator-view">
{% if regulator.typeUnsupported %}
  <p class="govuk-body" data-testid="regulator-view-unsupported">This work item type has no Regulator view in the Admin UI.</p>
{% else %}
  {{ appCaseHeader(regulator.caseHeader) }}

  {{ appCaseTabs({ tabs: regulator.caseTabs }) }}

  {% if regulator.pendingContactBanner %}
    {% set pendingContactHtml %}
      <p class="govuk-notification-banner__heading">{{ regulator.pendingContactBanner.text }}</p>
      {% if regulator.pendingContactBanner.accreditationId %}
        <p class="govuk-body">Accreditation ID: <strong data-testid="standard-lifecycle-pending-contact-accreditation-id">{{ regulator.pendingContactBanner.accreditationId }}</strong></p>
      {% endif %}
    {% endset %}
    {{ govukNotificationBanner({
      type: 'success',
      titleText: regulator.pendingContactBanner.title,
      html: pendingContactHtml,
      disableAutoFocus: true,
      role: 'region',
      attributes: { "data-testid": "standard-lifecycle-pending-contact-banner" }
    }) }}
  {% endif %}

  {% if regulator.withdrawnNotice %}
    {% set withdrawnNoticeHtml %}
      {{- regulator.withdrawnNotice.subject -}}
      {%- if regulator.withdrawnNotice.applicationRef %} <strong data-testid="work-item-withdrawn-reference">{{ regulator.withdrawnNotice.applicationRef }}</strong>{% endif %} {{ regulator.withdrawnNotice.tail -}}
    {% endset %}
    {{ govukErrorSummary({
      titleText: regulator.withdrawnNotice.title,
      errorList: [{ html: withdrawnNoticeHtml }],
      disableAutoFocus: true,
      attributes: { "data-testid": "work-item-withdrawn-notice" }
    }) }}
  {% endif %}

  {% if regulator.notificationFailedBanner %}
    {{ govukErrorSummary({
      titleText: 'There is a problem',
      errorList: [{ text: 'A notification email for this application could not be sent. Check the application history for details.' }],
      disableAutoFocus: true,
      attributes: { "data-testid": "work-item-notification-failed-banner" }
    }) }}
  {% endif %}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

  {% if regulator.processingTypeNotRecorded and regulator.tab != 'application-history' %}
    {{ govukWarningText({
      text: "This work item's application type is not recorded as reprocessor or exporter, so Case management's view of it can't be shown. The Document tab shows it as stored.",
      attributes: { "data-testid": "processing-type-not-recorded" }
    }) }}
  {% elif regulator.tab == 'application-summary' and regulator.summaryLayout == 'add-overseas-site' %}

    <h3 class="govuk-heading-m" data-testid="application-details-heading">Application details</h3>
    {% if regulator.applicationSummary.validFrom %}
      <dl class="govuk-summary-list app-summary-list--borderless govuk-!-margin-bottom-6"
          data-testid="application-valid-from">
        <div class="govuk-summary-list__row" data-testid="app-detail-row-valid-from">
          <dt class="govuk-summary-list__key">{{ regulator.applicationSummary.validFrom.label }}</dt>
          <dd class="govuk-summary-list__value" data-testid="app-detail-value-valid-from">
            <p class="govuk-body govuk-!-margin-bottom-0">{{ regulator.applicationSummary.validFrom.value }}</p>
          </dd>
        </div>
      </dl>
    {% endif %}
    <dl class="govuk-summary-list app-summary-list--borderless" data-testid="application-details">
      {% for row in regulator.applicationSummary.rows %}
        <div class="govuk-summary-list__row"
             data-testid="app-detail-row-{{ row.key }}">
          <dt class="govuk-summary-list__key">{{ row.label }}</dt>
          <dd class="govuk-summary-list__value"
              data-testid="app-detail-value-{{ row.key }}">
            {% if row.kind == 'files' %}
              {% if row.files.length %}
                <ul class="govuk-list govuk-!-margin-bottom-0">
                  {% for file in row.files %}{{ documentItem(file, showDates=true, newTestId=('app-detail-supplied-' + row.key) if (row.supplied and loop.first) else '') }}{% endfor %}
                </ul>
              {% else %}
                <span data-testid="app-detail-documents-none">No documents uploaded.</span>
              {% endif %}
            {% else %}
              {% for line in row.values %}
                <p class="govuk-body govuk-!-margin-bottom-0">{% if row.supplied and loop.first %}{{ newPrefix('app-detail-supplied-' + row.key) }}{% endif %}{{ line }}</p>
              {% endfor %}
            {% endif %}
          </dd>
        </div>
      {% endfor %}
    </dl>

    {% if regulator.applicationSummary.interimSites.length %}
      <div class="govuk-!-margin-top-8" data-testid="interim-sites">
        <h3 class="govuk-heading-m" data-testid="interim-sites-heading">Interim sites ({{ regulator.applicationSummary.interimSites.length }})</h3>
        {% for interimSite in regulator.applicationSummary.interimSites %}
          <div class="govuk-!-margin-bottom-4" data-testid="interim-site">
            <h4 class="govuk-heading-s govuk-!-margin-bottom-2">
              <span data-testid="interim-site-name">{{ interimSite.siteName }}</span>
              {% if interimSite.shortAddress %}
                <br>
                <span class="govuk-!-font-weight-regular" data-testid="interim-site-summary-address">{{ interimSite.shortAddress }}</span>
              {% endif %}
            </h4>
            {{ siteDetails(interimSite.details, 'interim-site') }}
          </div>
        {% endfor %}
      </div>
    {% endif %}

  {% elif regulator.tab == 'application-summary' %}
    {% if regulator.decisionMetadata %}
      {% if not regulator.isPendingContact %}
        {{ govukPanel({
          titleText: "Accreditation issued",
          html: 'Accreditation ID<br><strong data-testid="re-accreditation-approval-panel-id">'
                + (regulator.decisionMetadata.accreditationId | escape) + '</strong>',
          attributes: { "data-testid": "re-accreditation-approval-panel" }
        }) }}
      {% endif %}
      {% set metadataRows = [
        {
          key: { text: "Accreditation ID" },
          value: {
            html: '<span data-testid="re-accreditation-accreditation-id">'
                  + (regulator.decisionMetadata.accreditationId | escape) + '</span>'
          }
        }
      ] %}
      {% if regulator.decisionMetadata.showIssuedDetails %}
        {% set metadataRows = metadataRows.concat([
          {
            key: { text: "Accreditation start date" },
            value: {
              html: '<span data-testid="re-accreditation-accreditation-start-date">'
                    + (regulator.decisionMetadata.accreditationStartDateFormatted | escape)
                    + '</span>'
            }
          },
          {
            key: { text: "Accreditation year" },
            value: {
              html: '<span data-testid="re-accreditation-accreditation-year">'
                    + ((regulator.decisionMetadata.accreditationYear or '—') | escape)
                    + '</span>'
            }
          }
        ]) %}
      {% endif %}
      {{ govukSummaryList({
        attributes: { "data-testid": "re-accreditation-decision-metadata" },
        rows: metadataRows
      }) }}
    {% endif %}

    <h3 class="govuk-heading-m">Application details</h3>

    <dl class="govuk-summary-list app-summary-list--borderless"
        data-testid="application-details">
      {% for row in regulator.applicationSummary.rows %}
        <div class="govuk-summary-list__row"
             data-testid="app-detail-row-{{ row.key }}">
          <dt class="govuk-summary-list__key">{{ row.label }}</dt>
          <dd class="govuk-summary-list__value"
              data-testid="app-detail-value-{{ row.key }}">

            {% if row.kind == 'text' %}
              {{ row.value }}

            {% elif row.kind == 'lines' %}
              {% for line in row.values %}
                <p class="govuk-body govuk-!-margin-bottom-1"
                   data-testid="app-detail-line">{{ line }}</p>
              {% else %}
                —
              {% endfor %}

            {% elif row.kind == 'files' %}
              {% if row.files.length %}
                <ul class="govuk-list">
                  {% for file in row.files %}{{ documentItem(file, row.key == 'sampling-inspection-plan') }}{% endfor %}
                </ul>
              {% else %}
                <span data-testid="app-detail-documents-none">No documents uploaded.</span>
              {% endif %}

            {% elif row.kind == 'pairs' %}
              {% for pair in row.pairs %}{{ businessPlanPair(pair) }}
              {% else %}
                —
              {% endfor %}

            {% elif row.kind == 'bes-sites' %}
              {% for site in row.sites %}
                <div data-testid="bes-site">
                  <p class="govuk-body govuk-!-margin-bottom-1">
                    <strong>{{ site.siteName }}</strong>{% if site.country %} ({{ site.country }}){% endif %}
                  </p>
                  {% if site.files.length %}
                    <ul class="govuk-list">
                      {% for file in site.files %}{{ documentItem(file) }}{% endfor %}
                    </ul>
                  {% endif %}
                </div>
              {% else %}
                —
              {% endfor %}

            {% elif row.kind == 'overseas-sites' %}
              {{ overseasSiteList(row.sites) }}

            {% elif row.kind == 'authority-contacts' %}
              {% for contact in row.contacts %}
                <p class="govuk-body govuk-!-margin-bottom-1"
                   data-testid="authority-to-issue-contact">
                  {% if contact.isNew %}{{ newPrefix('authority-to-issue-new-tag') }}{% endif %}<span data-testid="authority-to-issue-contact-name">{{ contact.name }}</span>{% if contact.email %} ({{ contact.email }}){% endif %}
                </p>
              {% else %}
                —
              {% endfor %}
            {% endif %}

          </dd>
        </div>
      {% endfor %}
    </dl>

    {% if regulator.priorYear %}
      <h3 class="govuk-heading-m" data-testid="prior-year-heading">
        Previous year ({{ regulator.priorYear.year }})
      </h3>
      <dl class="govuk-summary-list app-summary-list--borderless"
          data-testid="prior-year-details">
        <div class="govuk-summary-list__row">
          <dt class="govuk-summary-list__key">PRN tonnage</dt>
          <dd class="govuk-summary-list__value"
              data-testid="prior-year-tonnage">{{ regulator.priorYear.tonnageBand }}</dd>
        </div>
        <div class="govuk-summary-list__row">
          <dt class="govuk-summary-list__key">PRN authorisers</dt>
          <dd class="govuk-summary-list__value" data-testid="prior-year-authorisers">
            {% for line in regulator.priorYear.authoriserLines %}
              <p class="govuk-body govuk-!-margin-bottom-1">{{ line }}</p>
            {% else %}
              —
            {% endfor %}
          </dd>
        </div>
        <div class="govuk-summary-list__row">
          <dt class="govuk-summary-list__key">Business plan</dt>
          <dd class="govuk-summary-list__value" data-testid="prior-year-business-plan">
            {% for pair in regulator.priorYear.businessPlanPairs %}{{ businessPlanPair(pair, 'prior-year-pair') }}
            {% else %}
              —
            {% endfor %}
          </dd>
        </div>
      </dl>
    {% endif %}

  {% elif regulator.tab == 'application-history' %}
    {% if regulator.auditLog.length > 0 %}
      <ol class="govuk-list" data-testid="work-item-audit-log">
        {% for entry in regulator.auditLog %}
          <li class="govuk-!-margin-bottom-3{% if entry.isFailure %} app-audit-entry--failure{% endif %}" data-testid="work-item-audit-entry-{{ entry.id }}" data-action="{{ entry.action }}">
            <p class="govuk-body govuk-!-margin-bottom-1">
              {% if entry.isFailure %}
                {{ govukTag({ text: "Failed", classes: "govuk-tag--red" }) }}
              {% endif %}
              <strong>{{ entry.actionDisplayName }}</strong>
              {% if entry.summary %}
                — {{ entry.summary }}
              {% endif %}
            </p>
            <p class="govuk-body-s govuk-hint govuk-!-margin-bottom-1">
              {{ entry.createdByName or entry.createdBy or "System" }} — {{ entry.createdAt | formatDateTimeGds }}
            </p>
            {% if entry.detailRows and entry.detailRows.length > 0 %}
              <details class="govuk-details govuk-!-margin-top-1 govuk-!-margin-bottom-0" data-testid="work-item-audit-entry-details">
                <summary class="govuk-details__summary">
                  <span class="govuk-details__summary-text">Show details</span>
                </summary>
                <div class="govuk-details__text">
                  <dl class="govuk-summary-list govuk-summary-list--no-border govuk-!-margin-bottom-0">
                    {% for row in entry.detailRows %}
                      <div class="govuk-summary-list__row">
                        <dt class="govuk-summary-list__key">{{ row.key }}</dt>
                        <dd class="govuk-summary-list__value">
                          {% if row.preformatted %}
                            <pre class="govuk-!-font-size-14 govuk-!-margin-top-0 govuk-!-margin-bottom-0"
                                 data-testid="work-item-audit-entry-detail-pre"><code>{{ row.value }}</code></pre>
                          {% elif row.multiline %}
                            {% for line in row.value.split('\n') %}
                              <p class="govuk-body govuk-!-margin-bottom-1">{{ line }}</p>
                            {% endfor %}
                          {% else %}
                            {{ row.value }}
                          {% endif %}
                        </dd>
                      </div>
                    {% endfor %}
                  </dl>
                </div>
              </details>
            {% endif %}
          </li>
        {% endfor %}
      </ol>
    {% else %}
      <p class="govuk-body" data-testid="work-item-no-audit-log">
        No actions have been recorded against this work item yet.
      </p>
    {% endif %}

  {% else %}
    <dl class="govuk-summary-list app-summary-list--borderless"
        data-testid="additional-information">
      {% for row in regulator.additionalInformationRows %}
        <div class="govuk-summary-list__row"
             data-testid="additional-information-row-{{ row.key }}">
          <dt class="govuk-summary-list__key">{{ row.label }}</dt>
          <dd class="govuk-summary-list__value"
              data-testid="additional-information-value-{{ row.key }}">{{ row.value }}</dd>
        </div>
      {% endfor %}
    </dl>
  {% endif %}

    </div>
  </div>
{% endif %}
</div>
