{% extends 'layouts/page.njk' %}

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% from "govuk/components/inset-text/macro.njk" import govukInsetText %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {% if error %}
        {{ govukErrorSummary({
          titleText: "There is a problem",
          errorList: [{ text: error }]
        }) }}
      {% endif %}

      <h1 class="govuk-heading-l">Sign in to {{ serviceName }}</h1>

      <p class="govuk-body">Use your @defra.gov.uk account.</p>

      {% if returnTo %}
        {{ govukInsetText({
          html: "After you sign in we'll take you to the page you asked for: <code data-testid=\"return-to\">" + (returnTo | escape) + "</code>"
        }) }}
      {% endif %}

      {{ govukButton({
        text: "Sign in with Microsoft Entra ID",
        href: "/auth/sign-in/entra" + ("?returnTo=" + (returnTo | urlencode) if returnTo else ""),
        isStartButton: true
      }) }}
    </div>
  </div>
{% endblock %}
